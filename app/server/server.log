n### syntax/validate.go (976 🪙)\n\nconst\n  - parserTimeout\ntype ValidationRes = struct\nfunc ValidateFile(ctx context.Context, path string, file string) (*ValidationRes, error)\nfunc ValidateWithParsers(ctx context.Context, lang shared.Language, parser *tree_sitter.Parser, fallbackLang shared.Language, fallbackParser *tree_sitter.Parser, file string) (*ValidationRes, error)\nfunc insertErrorMarkers(source string, node *tree_sitter.Node) []string\nfunc visitNodes(n *tree_sitter.Node, f func(node *tree_sitter.Node))\n\n### test_tracing.sh (261 🪙)\n\n[NO MAP]\n\n### types/active_plan.go (3117 🪙)\n\nconst\n  - MaxStreamRate\nconst\n  - ActivePlanTimeout\ntype ActiveBuild struct\ntype subscription struct\ntype ActivePlan struct\nfunc NewActivePlan(orgId, userId, planId, branch, prompt string, buildOnly, autoContext bool, sessionId string) *ActivePlan\nfunc (ap *ActivePlan) FlushStreamBuffer()\nconst\n  - verboseStreamLogging\nfunc (ap *ActivePlan) Stream(msg shared.StreamMessage)\nfunc (ap *ActivePlan) ResetModelCtx()\nfunc (ap *ActivePlan) BuildFinished() bool\nfunc (ap *ActivePlan) PathQueueEmpty(path string) bool\nfunc (ap *ActivePlan) Subscribe(reqCtx context.Context) (string, chan string)\nfunc (ap *ActivePlan) Unsubscribe(id string)\nfunc (ap *ActivePlan) NumSubscribers() int\nfunc (b *ActiveBuild) BuildFinished() bool\nfunc newSubscription(ctx context.Context) *subscription\nfunc (sub *subscription) processMessages()\nfunc (sub *subscription) enqueueMessage(msg string)\nfunc (ap *ActivePlan) Finish()\nfunc (ab *ActiveBuild) IsFileOperation() bool\n\n### types/active_plan_pending_builds.go (666 🪙)\n\nfunc (ap *ActivePlan) PendingBuildsByPath(orgId, userId string, convoMessagesArg []*db.ConvoMessage) (map[string][]*ActiveBuild, error)\n\n### types/auth.go (113 🪙)\n\ntype ServerAuth struct\nfunc (a *ServerAuth) HasPermission(permission shared.Permission) bool\nfunc (a *ServerAuth) HasPermissionForResource(permission shared.Permission, resourceId string) bool\n\n###